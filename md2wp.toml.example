[wordpress]
url = "https://example.com/wp-json/wp/v2"
username = "admin"
# password via env: MD2WP_WORDPRESS_PASSWORD

[wordpress.i18n]
# none | polylang | wpml  (env: MD2WP_I18N_PROVIDER)
provider = "none"
# Link language variants after publish (requires provider != none)
# env: MD2WP_I18N_LINK_TRANSLATIONS
link_translations = false

[import]
mode = "markdown"
source = "./content/posts"
# output = "./export/posts.xml"  # WXR export path (or MD2WP_EXPORT_OUTPUT)
status = "draft"
recursive = true
include_drafts = false

[markdown]
# Python-Markdown extensions (defaults shown)
extensions = ["fenced_code", "tables", "nl2br"]

[content]
# Wrap fenced <pre><code> as Gutenberg wp:code blocks (gutenberg | classic)
# env: MD2WP_CODE_BLOCKS
code_blocks = "gutenberg"

[site]
title = "My Site"
description = "Posts imported by md2wp"
language = "en"
domain = "https://example.com"

[hugo_build]
title_selector = "h1.post-title"
date_selector = "div.post-meta span[title]"
content_selector = "div.post-content"
tags_selector = "ul.post-tags a"
categories_selector = "div.breadcrumbs a"
category_breadcrumb_index = 2
filter_year_dirs = true
